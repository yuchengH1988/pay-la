rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUserDocument(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isValidShortName(value) {
      return value == null || (value is string && value.size() > 0 && value.size() <= 32);
    }

    function isRequestTime(value) {
      return value == request.time;
    }

    function hasValidUserProfileCreateShape() {
      return request.resource.data.keys().hasOnly([
        'displayName',
        'shortName',
        'email',
        'photoURL',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'displayName',
        'shortName',
        'email',
        'photoURL',
        'createdAt',
        'updatedAt'
      ])
      && isNullableString(request.resource.data.displayName)
      && isValidShortName(request.resource.data.shortName)
      && isNullableString(request.resource.data.email)
      && isNullableString(request.resource.data.photoURL)
      && isRequestTime(request.resource.data.createdAt)
      && isRequestTime(request.resource.data.updatedAt);
    }

    function isValidGroupName(name) {
      return name is string && name.size() > 0 && name.size() <= 80;
    }

    function isValidCurrency(currency) {
      return currency is string && currency in [
        'TWD',
        'USD',
        'JPY',
        'EUR',
        'GBP'
      ];
    }

    function isValidMemberIds(memberIds) {
      return memberIds is list
        && memberIds.size() >= 1
        && memberIds.size() <= 30;
    }

    function isGroupMember() {
      return isSignedIn()
        && request.auth.uid in resource.data.memberIds;
    }

    function hasValidGroupCreateShape() {
      return request.resource.data.keys().hasOnly([
        'name',
        'currency',
        'memberIds',
        'createdBy',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'name',
        'currency',
        'memberIds',
        'createdBy',
        'createdAt',
        'updatedAt'
      ])
      && isValidGroupName(request.resource.data.name)
      && isValidCurrency(request.resource.data.currency)
      && isValidMemberIds(request.resource.data.memberIds)
      && request.auth.uid in request.resource.data.memberIds
      && request.resource.data.createdBy == request.auth.uid
      && isRequestTime(request.resource.data.createdAt)
      && isRequestTime(request.resource.data.updatedAt);
    }

    function invitationPath(invitationId) {
      return /databases/$(database)/documents/invitations/$(invitationId);
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupData(groupId) {
      return get(groupPath(groupId)).data;
    }

    function isGroupMemberById(groupId) {
      return isSignedIn()
        && request.auth.uid in groupData(groupId).memberIds;
    }

    function hasValidInvitationCreateShape() {
      let group = get(groupPath(request.resource.data.groupId)).data;

      return request.resource.data.keys().hasOnly([
        'groupId',
        'createdBy',
        'status',
        'createdAt',
        'expiresAt',
        'usedBy',
        'usedAt'
      ])
      && request.resource.data.keys().hasAll([
        'groupId',
        'createdBy',
        'status',
        'createdAt',
        'expiresAt',
        'usedBy',
        'usedAt'
      ])
      && request.resource.data.groupId is string
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.status == 'active'
      && isRequestTime(request.resource.data.createdAt)
      && request.resource.data.expiresAt is timestamp
      && request.resource.data.expiresAt > request.time
      && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
      && request.resource.data.usedBy == null
      && request.resource.data.usedAt == null
      && request.auth.uid in group.memberIds
      && group.memberIds.size() < 30;
    }

    function hasValidInvitationUseShape(invitationId) {
      let groupBefore = get(groupPath(resource.data.groupId)).data;
      let groupAfter = getAfter(groupPath(resource.data.groupId)).data;

      return isSignedIn()
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time
        && !(request.auth.uid in groupBefore.memberIds)
        && groupBefore.memberIds.size() < 30
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'usedBy',
          'usedAt'
        ])
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && isRequestTime(request.resource.data.usedAt)
        && request.auth.uid in groupAfter.memberIds
        && groupAfter.memberIds.hasAll(groupBefore.memberIds)
        && groupAfter.memberIds.size() == groupBefore.memberIds.size() + 1
        && groupAfter.memberIds.size() <= 30
        && groupAfter.lastAcceptedInvitationId == invitationId;
    }

    function isValidInvitationJoin(groupId) {
      let invitationId = request.resource.data.lastAcceptedInvitationId;
      let invitationBefore = get(invitationPath(invitationId)).data;
      let invitationAfter = getAfter(invitationPath(invitationId)).data;

      return isSignedIn()
        && invitationId is string
        && invitationBefore.groupId == groupId
        && invitationBefore.status == 'active'
        && invitationBefore.expiresAt > request.time
        && invitationBefore.usedBy == null
        && invitationBefore.usedAt == null
        && invitationAfter.groupId == groupId
        && invitationAfter.status == 'used'
        && invitationAfter.usedBy == request.auth.uid
        && invitationAfter.usedAt is timestamp
        && !(request.auth.uid in resource.data.memberIds)
        && resource.data.memberIds.size() < 30
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= 30
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds',
          'updatedAt',
          'lastAcceptedInvitationId'
        ])
        && isRequestTime(request.resource.data.updatedAt);
    }

    function isValidExpenseCategory(category) {
      return category in [
        'food',
        'groceries',
        'transport',
        'housing',
        'utilities',
        'entertainment',
        'shopping',
        'travel',
        'health',
        'education',
        'subscriptions',
        'pets',
        'gifts',
        'insurance',
        'other'
      ];
    }

    function isValidSplitType(splitType) {
      return splitType in ['equal', 'exact', 'percentage'];
    }

    function hasValidExpenseShape(groupId) {
      let group = groupData(groupId);

      return request.resource.data.keys().hasOnly([
        'name',
        'amountMinor',
        'amountScale',
        'category',
        'paidBy',
        'participants',
        'splitType',
        'date',
        'note',
        'createdBy',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'name',
        'amountMinor',
        'amountScale',
        'category',
        'paidBy',
        'participants',
        'splitType',
        'date',
        'note',
        'createdBy',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 100
      && request.resource.data.amountMinor is int
      && request.resource.data.amountMinor > 0
      && request.resource.data.amountScale == 2
      && isValidExpenseCategory(request.resource.data.category)
      && request.resource.data.paidBy in group.memberIds
      && request.resource.data.participants is map
      && request.resource.data.participants.keys().size() >= 1
      && request.resource.data.participants.keys().hasOnly(group.memberIds)
      && isValidSplitType(request.resource.data.splitType)
      && request.resource.data.date is timestamp
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 500
      && request.resource.data.createdBy is string
      && request.resource.data.createdAt is timestamp
      && isRequestTime(request.resource.data.updatedAt);
    }

    function hasValidSettlementShape(groupId) {
      let group = groupData(groupId);

      return request.resource.data.keys().hasOnly([
        'payerId',
        'receiverId',
        'amountMinor',
        'amountScale',
        'date',
        'note',
        'createdBy',
        'createdAt'
      ])
      && request.resource.data.keys().hasAll([
        'payerId',
        'receiverId',
        'amountMinor',
        'amountScale',
        'date',
        'note',
        'createdBy',
        'createdAt'
      ])
      && request.resource.data.payerId in group.memberIds
      && request.resource.data.receiverId in group.memberIds
      && request.resource.data.payerId != request.resource.data.receiverId
      && request.resource.data.amountMinor is int
      && request.resource.data.amountMinor > 0
      && request.resource.data.amountScale == 2
      && request.resource.data.date is timestamp
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 500
      && request.resource.data.createdBy is string
      && request.resource.data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isOwnUserDocument(uid)
        && hasValidUserProfileCreateShape();

      allow update: if isOwnUserDocument(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'shortName',
          'email',
          'photoURL',
          'updatedAt'
        ])
        && isNullableString(request.resource.data.displayName)
        && isValidShortName(request.resource.data.shortName)
        && isNullableString(request.resource.data.email)
        && isNullableString(request.resource.data.photoURL)
        && isRequestTime(request.resource.data.updatedAt);

      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember();

      allow create: if isSignedIn()
        && hasValidGroupCreateShape();

      allow update: if (isGroupMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'currency',
          'updatedAt'
        ])
        && isValidGroupName(request.resource.data.name)
        && isValidCurrency(request.resource.data.currency)
        && isRequestTime(request.resource.data.updatedAt))
        || isValidInvitationJoin(groupId);

      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && hasValidInvitationCreateShape();

      allow update: if hasValidInvitationUseShape(invitationId);

      allow delete: if false;
    }

    match /groups/{groupId}/expenses/{expenseId} {
      allow read: if isGroupMemberById(groupId);

      allow create: if isGroupMemberById(groupId)
        && hasValidExpenseShape(groupId)
        && request.resource.data.createdBy == request.auth.uid
        && isRequestTime(request.resource.data.createdAt);

      allow update: if isGroupMemberById(groupId)
        && hasValidExpenseShape(groupId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isGroupMemberById(groupId);
    }

    match /groups/{groupId}/settlements/{settlementId} {
      allow read: if isGroupMemberById(groupId);

      allow create: if isGroupMemberById(groupId)
        && hasValidSettlementShape(groupId)
        && request.resource.data.createdBy == request.auth.uid
        && isRequestTime(request.resource.data.createdAt);

      allow update: if isGroupMemberById(groupId)
        && hasValidSettlementShape(groupId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isGroupMemberById(groupId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
